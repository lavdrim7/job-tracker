# Kopier til .env og fyll inn egne verdier. .env skal aldri committes.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=
SERVER_PORT=8080
# Påkrevd, ingen standardverdi. Minst 32 tegn. Generer f.eks. med: openssl rand -base64 48
JWT_SECRET=
# Valgfri. Levetid for token som ISO-8601-varighet (standard PT1H).
JWT_EXPIRATION=PT1H
